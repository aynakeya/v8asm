regw1: reg is nw1=1 & sw1 [ reg = 0x40 + ((-7 - sw1) * 8); ] { export *[register]:8 reg; }
regw1: "a0" reg is vw1=3 [ reg = 0x510; ] { export *[register]:8 reg; }
regw1: "a1" reg is vw1=4 [ reg = 0x518; ] { export *[register]:8 reg; }
