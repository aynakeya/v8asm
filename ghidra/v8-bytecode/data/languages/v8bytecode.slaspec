regw2: "<closure>" reg is vw2=0xfffe [ reg = 0x508; ] { export *[register]:8 reg; }
regw2: "<context>" reg is vw2=0xffff [ reg = 0x500; ] { export *[register]:8 reg; }
regw2: reg is nw2=1 & sw2 [ reg = 0x40 + ((-7 - sw2) * 8); ] { export *[register]:8 reg; }
