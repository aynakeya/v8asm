define endian=little;
define alignment=1;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x000 size=4 [ pc ];
define register offset=0x010 size=8 [ ACCU ];
define register offset=0x020 size=8 [ sp ];
define register offset=0x040 size=8 [
  r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
  r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
  r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47
  r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 r60 r61 r62 r63
  r64 r65 r66 r67 r68 r69 r70 r71 r72 r73 r74 r75 r76 r77 r78 r79
  r80 r81 r82 r83 r84 r85 r86 r87 r88 r89 r90 r91 r92 r93 r94 r95
  r96 r97 r98 r99 r100 r101 r102 r103 r104 r105 r106 r107 r108 r109 r110 r111
  r112 r113 r114 r115 r116 r117 r118 r119 r120 r121 r122 r123 r124 r125 r126 r127
];
define register offset=0x500 size=8 [ context closure a0 a1 a2 a3 a4 a5 a6 a7 ];
define register offset=0x550 size=8 [ receiver ];

define token opbyte (8)
  op=(0,7)
;

define token b1 (8)
  v1=(0,7)
  s1=(0,7) signed
  n1=(7,7)
;

define token b2 (8)
  v2=(0,7)
  s2=(0,7) signed
  n2=(7,7)
;

define token b3 (8)
  v3=(0,7)
  s3=(0,7) signed
  n3=(7,7)
;

define token b4 (8)
  v4=(0,7)
  s4=(0,7) signed
  n4=(7,7)
;

define token b5 (8)
  v5=(0,7)
  s5=(0,7) signed
;

define token opwide (8)
  opw=(0,7)
;

define token w1 (16)
  vw1=(0,15)
  sw1=(0,15) signed
  nw1=(15,15)
;

define token d1 (32)
  vd1=(0,31)
  sd1=(0,31) signed
  nd1=(31,31)
;

define token w2 (16)
  vw2=(0,15)
  sw2=(0,15) signed
  nw2=(15,15)
;

define token w3 (16)
  vw3=(0,15)
  sw3=(0,15) signed
  nw3=(15,15)
;

define token w4 (16)
  vw4=(0,15)
  sw4=(0,15) signed
  nw4=(15,15)
;

define token w5 (16)
  vw5=(0,15)
;

define token d2 (32)
  vd2=(0,31)
  sd2=(0,31) signed
  nd2=(31,31)
;

define token d3 (32)
  vd3=(0,31)
  sd3=(0,31) signed
  nd3=(31,31)
;

define token d4 (32)
  vd4=(0,31)
  sd4=(0,31) signed
  nd4=(31,31)
;

define token d5 (32)
  vd5=(0,31)
;

