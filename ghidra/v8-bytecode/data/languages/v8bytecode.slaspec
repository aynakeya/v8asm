reg4: "a5" reg is s4=8 [ reg = 0x538; ] { export *[register]:8 reg; }
reg4: "a6" reg is s4=9 [ reg = 0x540; ] { export *[register]:8 reg; }
reg4: "a7" reg is s4=10 [ reg = 0x548; ] { export *[register]:8 reg; }
