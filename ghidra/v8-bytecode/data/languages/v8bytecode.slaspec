regw4: "a4" reg is vw4=7 [ reg = 0x530; ] { export *[register]:8 reg; }

regd1: "<this>" reg is vd1=2 [ reg = 0x550; ] { export *[register]:8 reg; }
regd1: "<closure>" reg is vd1=0xfffffffe [ reg = 0x508; ] { export *[register]:8 reg; }
regd1: "<context>" reg is vd1=0xffffffff [ reg = 0x500; ] { export *[register]:8 reg; }
regd1: reg is nd1=1 & sd1 [ reg = 0x40 + ((-7 - sd1) * 8); ] { export *[register]:8 reg; }
regd1: "a0" reg is vd1=3 [ reg = 0x510; ] { export *[register]:8 reg; }
regd1: "a1" reg is vd1=4 [ reg = 0x518; ] { export *[register]:8 reg; }
regd1: "a2" reg is vd1=5 [ reg = 0x520; ] { export *[register]:8 reg; }
regd1: "a3" reg is vd1=6 [ reg = 0x528; ] { export *[register]:8 reg; }
regd1: "a4" reg is vd1=7 [ reg = 0x530; ] { export *[register]:8 reg; }

jump8: target is v1 [ target = inst_start + v1; ] { export *[ram]:4 target; }
jump16: target is vw1 [ target = inst_start + vw1 + 1; ] { export *[ram]:4 target; }
jump32: target is vd1 [ target = inst_start + vd1 + 1; ] { export *[ram]:4 target; }

loop8: target is v1 [ target = inst_start - v1; ] { export *[ram]:4 target; }
loop16: target is vw1 [ target = inst_start - vw1 + 1; ] { export *[ram]:4 target; }
loop32: target is vd1 [ target = inst_start - vd1 + 1; ] { export *[ram]:4 target; }

# Constants / loads
:LdaZero is op=0x0c { ACCU = 0; }
:LdaSmi s8_1 is op=0x0d; s8_1 { ACCU = s8_1; }
:LdaUndefined is op=0x0e { ACCU = 0xfffffffffffffff1; }
:LdaNull is op=0x0f { ACCU = 0xfffffffffffffff2; }
:LdaTheHole is op=0x10 { ACCU = 0xfffffffffffffff3; }
:LdaTrue is op=0x11 { ACCU = 1; }
:LdaFalse is op=0x12 { ACCU = 0; }
:LdaConstant u8_1 is op=0x13; u8_1 {
  local tmp:8 = V8LdaConstant(u8_1);
  ACCU = tmp;
}
:LdaContextSlot reg1,u8_2,u8_3 is op=0x14; reg1; u8_2; u8_3 {
  local tmp:8 = V8LdaContextSlot(reg1, u8_2, u8_3);
  ACCU = tmp;
}
:LdaScriptContextSlot reg1,u8_2,u8_3 is op=0x15; reg1; u8_2; u8_3 {
  local tmp:8 = V8LdaContextSlot(reg1, u8_2, u8_3);
  ACCU = tmp;
}
:LdaImmutableContextSlot reg1,u8_2,u8_3 is op=0x16; reg1; u8_2; u8_3 {
  local tmp:8 = V8LdaContextSlot(reg1, u8_2, u8_3);
  ACCU = tmp;
}
:LdaCurrentContextSlot u8_1 is op=0x17; u8_1 {
  local tmp:8 = V8LdaCurrentContextSlot(u8_1);
  ACCU = tmp;
}
:LdaCurrentScriptContextSlot u8_1 is op=0x18; u8_1 {
  local tmp:8 = V8LdaCurrentContextSlot(u8_1);
  ACCU = tmp;
}
:LdaImmutableCurrentContextSlot u8_1 is op=0x19; u8_1 {
  local tmp:8 = V8LdaCurrentContextSlot(u8_1);
  ACCU = tmp;
}
:LdaGlobal u8_1,u8_2 is op=0x23; u8_1; u8_2 {
  local tmp:8 = V8LdaGlobal(u8_1, u8_2);
  ACCU = tmp;
}
:LdaGlobalInsideTypeof u8_1,u8_2 is op=0x24; u8_1; u8_2 {
  local tmp:8 = V8LdaGlobal(u8_1, u8_2);
  ACCU = tmp;
}
:Ldar reg1 is op=0x0b; reg1 { ACCU = reg1; }

# Stores / moves
:Star reg1 is op=0x1a; reg1 { reg1 = ACCU; }
:Mov reg1,reg2 is op=0x1b; reg1; reg2 { reg2 = reg1; }
:PushContext reg1 is op=0x1c; reg1 { context = reg1; }
:PopContext reg1 is op=0x1d; reg1 { context = reg1; }
:StaContextSlot reg1,u8_2,u8_3 is op=0x26; reg1; u8_2; u8_3 {
  V8ContextStore(reg1, u8_2, u8_3, ACCU);
}
:StaCurrentContextSlot u8_1 is op=0x27; u8_1 { V8ContextStore(u8_1, ACCU); }
:StaScriptContextSlot reg1,u8_2,u8_3 is op=0x28; reg1; u8_2; u8_3 {
  V8ContextStore(reg1, u8_2, u8_3, ACCU);
}
:StaCurrentScriptContextSlot u8_1 is op=0x29; u8_1 { V8ContextStore(u8_1, ACCU); }
:StaGlobal u8_1,u8_2 is op=0x25; u8_1; u8_2 {
  V8StaGlobal(u8_1, ACCU, u8_2);
}

# StarN short forms frequently emitted by V8
:Star15 is op=0xbf { r15 = ACCU; }
:Star14 is op=0xc0 { r14 = ACCU; }
:Star13 is op=0xc1 { r13 = ACCU; }
:Star12 is op=0xc2 { r12 = ACCU; }
:Star11 is op=0xc3 { r11 = ACCU; }
:Star10 is op=0xc4 { r10 = ACCU; }
:Star9  is op=0xc5 { r9 = ACCU; }
:Star8  is op=0xc6 { r8 = ACCU; }
:Star7  is op=0xc7 { r7 = ACCU; }
:Star6  is op=0xc8 { r6 = ACCU; }
:Star5  is op=0xc9 { r5 = ACCU; }
:Star4  is op=0xca { r4 = ACCU; }
:Star3  is op=0xcb { r3 = ACCU; }
:Star2  is op=0xcc { r2 = ACCU; }
:Star1  is op=0xcd { r1 = ACCU; }
:Star0  is op=0xce { r0 = ACCU; }

# Property / iterator
:GetNamedProperty reg1,u8_2,u8_3 is op=0x33; reg1; u8_2; u8_3 {
  local tmp:8 = V8GetNamedProperty(reg1, u8_2, u8_3);
  ACCU = tmp;
}
:GetKeyedProperty reg1,u8_2 is op=0x35; reg1; u8_2 {
  local tmp:8 = V8GetKeyedProperty(reg1, ACCU, u8_2);
  ACCU = tmp;
}
:GetEnumeratedKeyedProperty reg1,reg2,reg3,u8_4 is op=0x36; reg1; reg2; reg3; u8_4 {
  local tmp:8 = V8GetEnumeratedKeyedProperty(reg1, reg2, reg3, u8_4);
  ACCU = tmp;
}
:GetIterator reg1,u8_2,u8_3 is op=0xbb; reg1; u8_2; u8_3 {
  local tmp:8 = V8GetIterator(reg1, u8_2, u8_3);
  ACCU = tmp;
}
:SetNamedProperty reg1,u8_2,u8_3 is op=0x39; reg1; u8_2; u8_3 {
  V8SetNamedProperty(reg1, u8_2, ACCU, u8_3);
}
:DefineNamedOwnProperty reg1,u8_2,u8_3 is op=0x3a; reg1; u8_2; u8_3 {
  V8DefineNamedOwnProperty(reg1, u8_2, ACCU, u8_3);
}
:SetKeyedProperty reg1,reg2,u8_3 is op=0x3b; reg1; reg2; u8_3 {
  V8SetKeyedProperty(reg1, reg2, ACCU, u8_3);
}
:DefineKeyedOwnProperty reg1,reg2,u8_3,u8_4 is op=0x3c; reg1; reg2; u8_3; u8_4 {
  V8DefineKeyedOwnProperty(reg1, reg2, ACCU, u8_3, u8_4);
}
:StaInArrayLiteral reg1,reg2,u8_3 is op=0x3d; reg1; reg2; u8_3 {
  V8StaInArrayLiteral(reg1, reg2, ACCU, u8_3);
}

# Calls (partial, common forms)
:CallProperty reg1,reg2,u8_3,u8_4 is op=0x63; reg1; reg2; u8_3; u8_4 {
  local tmp:8 = V8CallProperty(reg1, reg2, u8_3, u8_4);
  ACCU = tmp;
}
:CallUndefinedReceiver reg1,reg2,u8_3,u8_4 is op=0x67; reg1; reg2; u8_3; u8_4 {
  local tmp:8 = V8CallUndefinedReceiver(reg1, reg2, u8_3, u8_4);
  ACCU = tmp;
}
:CallProperty0 reg1,reg2,u8_3 is op=0x64; reg1; reg2; u8_3 {
  local tmp:8 = V8CallProperty0(reg1, reg2, u8_3);
  ACCU = tmp;
}
:CallProperty1 reg1,reg2,reg3,u8_4 is op=0x65; reg1; reg2; reg3; u8_4 {
