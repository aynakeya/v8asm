reg1: "<this>" reg is v1=2 [ reg = 0x550; ] { export *[register]:8 reg; }
reg1: "a0" reg is s1=3 [ reg = 0x510; ] { export *[register]:8 reg; }
reg1: "a1" reg is s1=4 [ reg = 0x518; ] { export *[register]:8 reg; }
reg1: "a2" reg is s1=5 [ reg = 0x520; ] { export *[register]:8 reg; }
reg1: "a3" reg is s1=6 [ reg = 0x528; ] { export *[register]:8 reg; }
reg1: "a4" reg is s1=7 [ reg = 0x530; ] { export *[register]:8 reg; }
reg1: "a5" reg is s1=8 [ reg = 0x538; ] { export *[register]:8 reg; }
reg1: "a6" reg is s1=9 [ reg = 0x540; ] { export *[register]:8 reg; }
reg1: "a7" reg is s1=10 [ reg = 0x548; ] { export *[register]:8 reg; }
reg1: "<closure>" reg is v1=0xfe [ reg = 0x508; ] { export *[register]:8 reg; }
reg1: "<context>" reg is v1=0xff [ reg = 0x500; ] { export *[register]:8 reg; }
reg1: reg is n1=1 & v1 [ reg = 0x40 + ((0xf9 - v1) * 8); ] { export *[register]:8 reg; }

