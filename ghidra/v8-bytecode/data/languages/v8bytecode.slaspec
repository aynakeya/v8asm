# Arithmetic / comparison tests
:Add reg1,u8_2 is op=0x3f; reg1; u8_2 { ACCU = reg1 + ACCU; }
:Sub reg1,u8_2 is op=0x40; reg1; u8_2 { ACCU = reg1 - ACCU; }
:Mul reg1,u8_2 is op=0x41; reg1; u8_2 { ACCU = reg1 * ACCU; }
:Div reg1,u8_2 is op=0x42; reg1; u8_2 { ACCU = reg1 / ACCU; }
:Mod reg1,u8_2 is op=0x43; reg1; u8_2 { ACCU = reg1 % ACCU; }
:BitwiseOr reg1,u8_2 is op=0x45; reg1; u8_2 { ACCU = reg1 | ACCU; }
:BitwiseAnd reg1,u8_2 is op=0x47; reg1; u8_2 { ACCU = reg1 & ACCU; }
:ShiftLeft reg1,u8_2 is op=0x48; reg1; u8_2 { ACCU = reg1 << ACCU; }
:ShiftRight reg1,u8_2 is op=0x49; reg1; u8_2 { ACCU = reg1 s>> ACCU; }
:AddSmi s8_1,u8_2 is op=0x4b; s8_1; u8_2 { ACCU = ACCU + s8_1; }
:SubSmi s8_1,u8_2 is op=0x4c; s8_1; u8_2 { ACCU = ACCU - s8_1; }
:MulSmi s8_1,u8_2 is op=0x4d; s8_1; u8_2 { ACCU = ACCU * s8_1; }
:DivSmi s8_1,u8_2 is op=0x4e; s8_1; u8_2 { ACCU = ACCU / s8_1; }
:ModSmi s8_1,u8_2 is op=0x4f; s8_1; u8_2 { ACCU = ACCU % s8_1; }
:BitwiseOrSmi s8_1,u8_2 is op=0x51; s8_1; u8_2 { ACCU = ACCU | s8_1; }
:BitwiseAndSmi s8_1,u8_2 is op=0x53; s8_1; u8_2 { ACCU = ACCU & s8_1; }
:ShiftLeftSmi s8_1,u8_2 is op=0x54; s8_1; u8_2 { ACCU = ACCU << s8_1; }
:Inc u8_1 is op=0x57; u8_1 { ACCU = ACCU + 1; }
:Dec u8_1 is op=0x58; u8_1 { ACCU = ACCU - 1; }
:BitwiseNot u8_1 is op=0x5a; u8_1 { ACCU = ~ACCU; }
:ToBooleanLogicalNot is op=0x5b {
  local tmp:8 = V8ToBoolean(ACCU);
  ACCU = zext(tmp == 0);
}
:LogicalNot is op=0x5c { ACCU = zext(ACCU == 0); }
:DeletePropertySloppy reg1 is op=0x5f; reg1 {
  local tmp:8 = V8DeleteProperty(reg1, ACCU);
  ACCU = tmp;
}
:ToNumeric u8_1 is op=0x7d; u8_1 {
  local tmp:8 = V8ToNumeric(ACCU, u8_1);
  ACCU = tmp;
}
:ToObject reg1 is op=0x7e; reg1 {
  local tmp:8 = V8ToObject(ACCU);
  reg1 = tmp;
  ACCU = tmp;
}
:ToString is op=0x7f {
  local tmp:8 = V8ToString(ACCU);
  ACCU = tmp;
}
:ToBoolean is op=0x80 {
  local tmp:8 = V8ToBoolean(ACCU);
  ACCU = tmp;
}
:TestReferenceEqual reg1 is op=0x1e; reg1 { ACCU = zext(reg1 == ACCU); }
:TestUndetectable is op=0x1f {
  local tmp:8 = V8TestUndetectable(ACCU);
  ACCU = tmp;
}
:TestUndefined is op=0x21 { ACCU = zext(ACCU == 0xfffffffffffffff1); }
:TestTypeOf u8_1 is op=0x22; u8_1 {
  local tmp:8 = V8TestTypeOf(ACCU, u8_1);
  ACCU = tmp;
}
:TestEqual reg1,u8_2 is op=0x73; reg1; u8_2 { ACCU = zext(reg1 == ACCU); }
:TestEqualStrict reg1,u8_2 is op=0x74; reg1; u8_2 { ACCU = zext(reg1 == ACCU); }
:TestGreaterThan reg1,u8_2 is op=0x76; reg1; u8_2 { ACCU = zext(reg1 s> ACCU); }
:TestLessThan reg1,u8_2 is op=0x75; reg1; u8_2 { ACCU = zext(reg1 s< ACCU); }
:TestLessThanOrEqual reg1,u8_2 is op=0x77; reg1; u8_2 { ACCU = zext(reg1 s<= ACCU); }
:TestGreaterThanOrEqual reg1,u8_2 is op=0x78; reg1; u8_2 { ACCU = zext(reg1 s>= ACCU); }
:TestInstanceOf reg1,u8_2 is op=0x79; reg1; u8_2 {
  local tmp:8 = V8TestInstanceOf(reg1, ACCU, u8_2);
