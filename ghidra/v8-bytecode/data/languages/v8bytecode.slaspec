}

# Branches
:Jump jump8 is op=0x93; jump8 { goto jump8; }
:JumpConstant u8_1 is op=0x94; u8_1 {
  local kind:8 = 0;
  V8JumpConstant(kind, u8_1, ACCU);
  return [pc];
}
:JumpIfUndefinedConstant u8_1 is op=0x97; u8_1 {
  local kind:8 = 1;
  V8JumpConstant(kind, u8_1, ACCU);
}
:JumpIfUndefinedOrNullConstant u8_1 is op=0x99; u8_1 {
  local kind:8 = 2;
  V8JumpConstant(kind, u8_1, ACCU);
}
:JumpIfTrueConstant u8_1 is op=0x9a; u8_1 {
  local kind:8 = 3;
  V8JumpConstant(kind, u8_1, ACCU);
}
:JumpIfForInDoneConstant u8_1,reg2,reg3 is op=0x9d; u8_1; reg2; reg3 {
  local kind:8 = 4;
  V8JumpConstant(kind, u8_1, reg2, reg3, ACCU);
}
:JumpIfToBooleanTrueConstant u8_1 is op=0x9e; u8_1 {
  local kind:8 = 5;
  V8JumpConstant(kind, u8_1, ACCU);
}
:JumpIfToBooleanFalseConstant u8_1 is op=0x9f; u8_1 {
  local kind:8 = 6;
  V8JumpConstant(kind, u8_1, ACCU);
}
:JumpLoop loop8,u8_2,u8_3 is op=0x92; loop8; u8_2; u8_3 { goto loop8; }
:JumpIfToBooleanTrue jump8 is op=0xa0; jump8 { if (ACCU != 0) goto jump8; }
:JumpIfToBooleanFalse jump8 is op=0xa1; jump8 { if (ACCU == 0) goto jump8; }
:JumpIfTrue jump8 is op=0xa2; jump8 { if (ACCU != 0) goto jump8; }
:JumpIfFalse jump8 is op=0xa3; jump8 { if (ACCU == 0) goto jump8; }
:JumpIfNull jump8 is op=0xa4; jump8 {
  if (ACCU == 0xfffffffffffffff2) goto jump8;
}
:JumpIfNotNull jump8 is op=0xa5; jump8 {
  if (ACCU != 0xfffffffffffffff2) goto jump8;
}
:JumpIfUndefined jump8 is op=0xa6; jump8 {
  if (ACCU == 0xfffffffffffffff1) goto jump8;
}
:JumpIfNotUndefined jump8 is op=0xa7; jump8 {
  if (ACCU != 0xfffffffffffffff1) goto jump8;
}
:JumpIfUndefinedOrNull jump8 is op=0xa8; jump8 {
  if (ACCU == 0xfffffffffffffff1) goto jump8;
  if (ACCU == 0xfffffffffffffff2) goto jump8;
}
:JumpIfJSReceiver jump8 is op=0xa9; jump8 { if (ACCU != 0) goto jump8; }
:JumpIfForInDone jump8,reg2,reg3 is op=0xaa; jump8; reg2; reg3 {
  local tmp:8 = V8ForInDone(reg2, reg3);
  if (tmp != 0) goto jump8;
}
:SwitchOnSmiNoFeedback u8_1,u8_2,s8_3 is op=0xab; u8_1; u8_2; s8_3 {
  V8SwitchOnSmiNoFeedback(ACCU, u8_1, u8_2, s8_3);
}

:ForInEnumerate reg1 is op=0xac; reg1 {
  local tmp:8 = V8ForInEnumerate(reg1);
  ACCU = tmp;
}
:ForInPrepare reg1,u8_2 is op=0xad; reg1; u8_2 {
  V8ForInPrepare(reg1, ACCU, u8_2);
}
:ForInNext reg1,reg2,reg3,u8_4 is op=0xae; reg1; reg2; reg3; u8_4 {
